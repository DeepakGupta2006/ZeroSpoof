# Copy to .env (docker compose reads it automatically). Everything has a dev default,
# so the stack starts without it. CHANGE ALL SECRETS before exposing anything to the internet.
ZS_ENV=dev                      # set to "prod" to refuse dev secrets, disable dev keys, hide scores from the browser
POSTGRES_PASSWORD=zerospoof
ZS_ADMIN_KEY=zs_admin_dev
ZS_DEV_API_KEY=zs_live_dev
ZS_TOKEN_SECRET=dev-token-secret-change-me
ZS_PUBLIC_WS_URL=ws://localhost:8080/ws
ZS_ALLOWED_ORIGINS=http://localhost:3000
ZS_CORS_ORIGINS=http://localhost:3000
DASHBOARD_PASSWORD=             # empty = open dashboard (local dev only)
